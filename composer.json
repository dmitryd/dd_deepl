{
	"name": "dmitryd/dd-deepl",
	"type": "typo3-cms-extension",
	"description": "A TYPO3 CMS extension to translate pages, content and records with DeepL",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.2.0,<8.5.0",
		"typo3/cms-core": "^14.3",
		"typo3/cms-backend": "*",
		"deeplcom/deepl-php": "^1.5",
		"phplucidframe/console-table": "^1.2",
		"symfony/console": "^6.4 || ^7.0"
	},
	"conflict": {
		"pits/deepltranslate": "*",
		"web-vision/wv_deepltranslate": "*"
	},
	"suggest": {
		"undkonsorten/extbase-cli-aware-configuration-manager": "*"
	},
	"autoload": {
		"psr-4": {
			"Dmitryd\\DdDeepl\\": "Classes"
		}
	},
	"extra": {
		"typo3/cms": {
			"extension-key": "dd_deepl"
		}
	}
}
